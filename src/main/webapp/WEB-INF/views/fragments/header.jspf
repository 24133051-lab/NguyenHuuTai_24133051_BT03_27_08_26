<%@ page pageEncoding="UTF-8" %>
<header class="site-header">
    <div class="container header-inner">
        <a class="brand" href="${pageContext.request.contextPath}/" aria-label="Nova Store - Trang chủ">
            <span class="brand-mark">N</span>
            <span>NOVA</span>
        </a>

        <button class="nav-toggle" type="button" aria-label="Mở menu" aria-expanded="false" data-nav-toggle>
            <span></span><span></span><span></span>
        </button>

        <nav class="main-nav" data-main-nav>
            <a href="${pageContext.request.contextPath}/">Trang chủ</a>
            <a href="${pageContext.request.contextPath}/product">Sản phẩm</a>
            <c:if test="${not empty sessionScope.currentUser}">
                <a href="${pageContext.request.contextPath}/admin/products">Quản trị</a>
            </c:if>
        </nav>

        <div class="header-actions">
            <c:choose>
                <c:when test="${empty sessionScope.currentUser}">
                    <a class="text-link" href="${pageContext.request.contextPath}/login">Đăng nhập</a>
                    <a class="btn btn-primary btn-small" href="${pageContext.request.contextPath}/register">Đăng ký</a>
                </c:when>
                <c:otherwise>
                    <span class="user-chip">
                        <span class="avatar"><c:out value="${fn:substring(sessionScope.currentUser.fullName, 0, 1)}"/></span>
                        <span class="user-chip-text">
                            <small>Xin chào</small>
                            <strong><c:out value="${sessionScope.currentUser.fullName}"/></strong>
                        </span>
                    </span>
                    <a class="text-link" href="${pageContext.request.contextPath}/logout">Đăng xuất</a>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</header>

<c:if test="${not empty sessionScope.flashSuccess}">
    <div class="container flash-wrap">
        <div class="alert alert-success"><span>✓</span><c:out value="${sessionScope.flashSuccess}"/></div>
    </div>
    <c:remove var="flashSuccess" scope="session"/>
</c:if>
<c:if test="${not empty sessionScope.flashError}">
    <div class="container flash-wrap">
        <div class="alert alert-error"><span>!</span><c:out value="${sessionScope.flashError}"/></div>
    </div>
    <c:remove var="flashError" scope="session"/>
</c:if>
